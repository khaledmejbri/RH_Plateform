# Copier en .env (jamais commité) puis remplir. Générer chaque secret avec :  openssl rand -hex 32

# Nom de domaine public (HTTPS automatique). Exemples :
#   sirh-demo.duckdns.org   (sous-domaine gratuit DuckDNS pointant sur l'IP publique de la machine)
#   :80                     (HTTP simple : test local, ou derrière un Cloudflare Tunnel)
DOMAINE=sirh-demo.duckdns.org


# Base de données
POSTGRES_USER=sirh
POSTGRES_PASSWORD=a-generer

# Secret partagé pour les appels de service à service (identité, notification, référentiel, évaluation)
INTERNAL_API_TOKEN=a-generer

# Signature des QR de pointage (papier et borne). Le changer invalide tous les QR déjà imprimés.
PRESENCE_QR_HMAC_SECRET=a-generer

# E-mails : par défaut capturés par Mailpit (non envoyés). Pour un vrai envoi, mettre le serveur SMTP du client.
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=no-reply@sirh.local

# Mémoire maximale par service Java (7 services). 512m convient à une machine de 8 Go et plus.
JAVA_XMX=512m

# Ports publics (laisser 80 / 443 en production)
HTTP_PORT=80
HTTPS_PORT=443
